# ---- freeLatex server configuration ----
# Copy to `server/.env` and adjust. Never commit the real .env.

# Required. Master credential for the instance.
# In AUTH_MODE=single this is the only key you need.
# In AUTH_MODE=multi the admin uses this to provision per-user keys.
ADMIN_API_KEY=change-me-to-a-long-random-string

# "single" = one master key, private instance.
# "multi"  = admin provisions sk_user_... keys, isolated workspaces per user.
AUTH_MODE=single

# HTTP + WebSocket listener.
PORT=3030
HOST=0.0.0.0

# Where the SQLite database and project files live.
DATA_DIR=data

# Max milliseconds a LaTeX compilation may run before it is killed.
COMPILE_TIMEOUT_MS=30000

# How many compilations may run at the same time.
# Defaults to the machine's core count, capped at 4. Each compilation is a
# whole TeX engine and wants about 190 MB while it runs, so a host with
# little memory should set this to 1.
# MAX_CONCURRENT_COMPILATIONS=1

# The origin allowed to call the API from a browser, if any.
# Leave it unset for the usual deployment: the server serves the client
# itself, so the browser talks to one origin and no cross-origin access is
# needed. Set it (for example http://localhost:5173) only when the client is
# served from somewhere else.
# CORS_ORIGIN=

# NODE_ENV=production
