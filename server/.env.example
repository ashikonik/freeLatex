# ---- freeLatex server configuration ----
# Copy to `server/.env` and adjust. Never commit the real .env.

# Required. Master credential for the instance.
# In AUTH_MODE=single this is the only key you need.
# In AUTH_MODE=multi the admin uses this to provision per-user keys.
ADMIN_API_KEY=change-me-to-a-long-random-string

# "single" = one master key, private instance.
# "multi"  = admin provisions sk_user_... keys, isolated workspaces per user.
AUTH_MODE=single

# HTTP + WebSocket listener.
PORT=3030
HOST=0.0.0.0

# Where the SQLite database and project files live.
DATA_DIR=data

# Max milliseconds a LaTeX compilation may run before it is killed.
COMPILE_TIMEOUT_MS=30000

# NODE_ENV=production
